; SID (MOS 6581/8580) registers
;
; The SID register block is mapped at $D400-$D41C.
; Registers are mirrored throughout the SID address range; these
; declarations use the primary I/O addresses.

; Voice 1 registers
.set SID_VOICE_1_FREQ_LSB = 0xD400
.set SID_VOICE_1_FREQ_MSB = 0xD401
.set SID_VOICE_1_PW_LSB = 0xD402
.set SID_VOICE_1_PW_MSB = 0xD403
.set SID_VOICE_1_CONTROL = 0xD404
.set SID_VOICE_1_ATTACK_DECAY = 0xD405
.set SID_VOICE_1_SUSTAIN_RELEASE = 0xD406

; Voice 2 registers
.set SID_VOICE_2_FREQ_LSB = 0xD407
.set SID_VOICE_2_FREQ_MSB = 0xD408
.set SID_VOICE_2_PW_LSB = 0xD409
.set SID_VOICE_2_PW_MSB = 0xD40A
.set SID_VOICE_2_CONTROL = 0xD40B
.set SID_VOICE_2_ATTACK_DECAY = 0xD40C
.set SID_VOICE_2_SUSTAIN_RELEASE = 0xD40D

; Voice 3 registers
.set SID_VOICE_3_FREQ_LSB = 0xD40E
.set SID_VOICE_3_FREQ_MSB = 0xD40F
.set SID_VOICE_3_PW_LSB = 0xD410
.set SID_VOICE_3_PW_MSB = 0xD411
.set SID_VOICE_3_CONTROL = 0xD412
.set SID_VOICE_3_ATTACK_DECAY = 0xD413
.set SID_VOICE_3_SUSTAIN_RELEASE = 0xD414

; Filter registers
.set SID_FILTER_CUTOFF_LSB = 0xD415
.set SID_FILTER_CUTOFF_MSB = 0xD416
.set SID_FILTER_RES_FILT = 0xD417
.set SID_FILTER_MODE_VOLUME = 0xD418

; Analog input and read-only registers
.set SID_PADDLE_X = 0xD419
.set SID_PADDLE_Y = 0xD41A
.set SID_OSCILLATOR_3 = 0xD41B
.set SID_ENVELOPE_3 = 0xD41C

; Voice control bits
.set SID_CONTROL_GATE = 0x01
.set SID_CONTROL_SYNC = 0x02
.set SID_CONTROL_RING_MOD = 0x04
.set SID_CONTROL_TEST = 0x08
.set SID_CONTROL_TRIANGLE = 0x10
.set SID_CONTROL_SAWTOOTH = 0x20
.set SID_CONTROL_PULSE = 0x40
.set SID_CONTROL_NOISE = 0x80

; Filter routing and resonance bits
.set SID_FILTER_VOICE_1 = 0x01
.set SID_FILTER_VOICE_2 = 0x02
.set SID_FILTER_VOICE_3 = 0x04
.set SID_FILTER_EXTERNAL = 0x08
.set SID_FILTER_RESONANCE_MASK = 0xF0

; Filter mode and master volume bits
.set SID_FILTER_MODE_LOW_PASS = 0x10
.set SID_FILTER_MODE_BAND_PASS = 0x20
.set SID_FILTER_MODE_HIGH_PASS = 0x40
.set SID_FILTER_VOICE_3_OFF = 0x80
.set SID_VOLUME_MASK = 0x0F
