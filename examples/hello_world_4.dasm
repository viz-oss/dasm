# Include robi prawdziwe wklejenia dzięki temu można zacząć od stuba np. macos.dasm i w nim .include 'main'
.include 'sys/darwin/print.dasm'
.include 'sys/darwin/exit'

# A import robi inteligentne wklejanie (tylko gdy faktycznie użyto)
.import 'sys/{.env OS}'

😎:
    print('Hello, World!\n')
    exit()

main: 😎

# można też
.include 'sys/darwin'
darwin.print('Hello, World!\n')

# albo
sys:
    .include 'sys/{.env OS}'
sys.print('Hello, World!\n')
