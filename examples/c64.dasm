; Program: Zmiana koloru ramki i tła w C64
;.import 'sys/c64/vic'
; start:
;   vic_frame_color(13)
;   vic_bg_color(14)
;   start()

; Może takie coś co pomoże w potokowaniu
; 0xD020 = r0 = 13
; 0xD021 = r0 = 14

.import 'sys/c64/vic'

start:
  r0 = VIC_RED          ; lda #$02
  VIC_FRAME_COLOR = r0  ; sta $d020 (kolor ramki)
  r0 = 10               ; lda #$03
  VIC_BG_COLOR = r0     ; sta $d021 (kolor tła)
  .b 0x60               ; rts (return to os)

  ;start()      ; jmp $080d
  ;.b 0x4C, 0x0D, 0x08             ; jmp $080d
