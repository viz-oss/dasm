; Program: Zmiana koloru ramki i tła w C64
; Adres startowy w pamięci RAM: $1000 (4096 dziesiętnie)

start:
  .b 0xA9, 0x02                   ; lda #$02
  .b 0x8D, 0x20, 0xD0             ; sta $d020 (kolor ramki)
  .b 0xA9, 0x03                   ; lda #$03
  .b 0x8D, 0x21, 0xD0             ; sta $d021 (kolor tła)
  .b 0x4C, 0x0D, 0x08             ; jmp $080d

