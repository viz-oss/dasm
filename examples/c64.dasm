; Program: Zmiana koloru ramki i tła w C64
;.import 'sys/c64/vic'
; start:
;   vic_frame_color(13)
;   vic_bg_color(14)
;   start()

; Może takie coś co pomoże w potokowaniu
; 0xD020 = r0 = 13
; 0xD021 = r0 = 14

.import 'sys/c64/vic'
; .start main ?

exit:
  .b 0x60

main:
  r0 = VIC_CYAN
  VIC_FRAME_COLOR = r0
  r0 = VIC_BLUE
  VIC_BG_COLOR = r0
  exit()
