; Program: Zmiana koloru ramki i tła w C64

.start 🚀
;.import 'platform/c64/asm.dasm' ; wszystkie mnemoniki zdefiniowane duzymi literami
.import 'platform/c64/sys.dasm'
.import 'platform/c64/vic.dasm'

🚀:
