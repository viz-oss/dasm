; Program: Zmiana koloru ramki i tła w C64
;.import 'sys/c64/vic'
; start:
;   vic_frame_color(13)
;   vic_bg_color(14)
;   start()

; Może takie coś co pomoże w potokowaniu
; 0xD020 = r0 = 13
; 0xD021 = r0 = 14

.start main
.import 'std/c64/sys.dasm'
.import 'std/c64/vic.dasm'

int:
  .b 0
  
vic_frame_color:
  r0 = VIC_LIGHT_BLUE
  VIC_FRAME_COLOR = r0

vic_bg_color:
  r0 = VIC_LIGHT_GREY
  VIC_BG_COLOR = r0

main:
  vic_frame_color()
  vic_bg_color()
  exit()
