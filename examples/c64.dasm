;  start()               ; jmp $080d TODO: jeszcze $080d jest na sztywno, czeka na tablice relokacji

start:
  r0 = 14      ; lda #$02
  0xD020 = r0  ; sta $d020 (kolor ramki)
  r0 = 15      ; lda #$03
  0xD021 = r0  ; sta $d021 (kolor tła)
  start()      ; jmp $080d
