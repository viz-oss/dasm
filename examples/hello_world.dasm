# Program entry
main:
    # 1. Wywołanie systemowe write (syscall 4 dla macOS ARM64)
    r0 = 1                 # File descriptor: 1 = stdout (ekran)
    r1 = message           # Pobranie adresu etykiety message
    r2 = 14                # Długość wiadomości
    r16 = 4                # Numer wywołania systemowego (syscall) dla sys_write to 4
    sys(0x80)              # Wywołanie kernela macOS
  
    # 2. Wywołanie systemowe exit (syscall 1 dla macOS ARM64)
    r0 = 0                 # Kod powrotu: 0 (sukces)
    r16 = 1                # Numer wywołania systemowego dla sys_exit to 1
    sys(0x80)              # Wywołanie kernela macOS

message: 'Hello, World!\n'

"""
// Program entry
main:
    // 1. Wywołanie systemowe write (syscall 4 dla macOS ARM64)
    mov r0, 1              // File descriptor: 1 = stdout (ekran)
    adr r1, message        // Pobranie adresu etykiety message
    mov r2, 14             // Długość wiadomości
    mov r16, 4             // Numer wywołania systemowego (syscall) dla sys_write to 4
    sys 0x80               // Wywołanie kernela macOS
  
    // 2. Wywołanie systemowe exit (syscall 1 dla macOS ARM64)
    mov x0, 0              // Kod powrotu: 0 (sukces)
    mov x16, 1             // Numer wywołania systemowego dla sys_exit to 1
    sys 0x80               // Wywołanie kernela macOS

message: "Hello, World!\n"
