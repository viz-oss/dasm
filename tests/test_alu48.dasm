; Przykladowy program testowy dla alu4
; Kazda linia = jedna instrukcja testujaca ALU
; Format: MNEMONIC A [Cn]
;   A  = wartosc 4-bit wpisywana do rejestru A (0-15)
;   Cn = opcjonalny carry-in override (0 lub 1), domyslnie 0

ADD 5        ; A=5, ADD, Cn=0 -> wynik A+B
ADD 5, 1     ; A=5, ADD, Cn=1 -> wynik A+B+1
SUB 10       ; A=10, SUB
AND 0b1010   ; A=1010, AND
OR  0xF      ; A=15, OR
XOR 3        ; A=3, XOR
NOT 0        ; A=0, NOT A
SHL 4        ; A=4, SHL
SHR 8        ; A=8, SHR (logika zewnetrzna)
